[15.65, "o", "\r\r\nThe \u001b[48;5;235m\u001b[38;5;249m\u001b[1mWinterJS.media\u001b[0m object decodes audio to f32 PCM, plays PCM through\r\r\nthe default output device, encodes AV1 video, and demuxes MP4. Audio rides\r\r\n\u001b[48;5;235m\u001b[38;5;249msymphonia\u001b[49m\u001b[39m, playback rides \u001b[48;5;235m\u001b[38;5;249mrodio\u001b[49m\u001b[39m, AV1 rides \u001b[48;5;235m\u001b[38;5;249mrav1e\u001b[49m\u001b[39m, MP4 rides \u001b[48;5;235m\u001b[38;5;249mmp4-rs\u001b[49m\u001b[39m.\r\r\n\r\r\n\u001b[4mSyntax\u001b[0m\r\r\n\r\r\n\u001b[48;5;235m\u001b[38;5;249mWinterJS.media.audioInfo(bytes)\u001b[49m\u001b[39m\u001b[48;5;235m\u001b[38;5;249m                           \u001b[49m\u001b[39m\r\r\n\u001b[48;5;235m\u001b[38;5;249mWinterJS.media.decodeAudio(bytes)\u001b[49m\u001b[39m\u001b[48;5;235m\u001b[38;5;249m                         \u001b[49m\u001b[39m\r\r\n\u001b[48;5;235m\u001b[38;5;249mWinterJS.media.play({ data, sampleRate, channels })\u001b[49m\u001b[39m\u001b[48;5;235m\u001b[38;5;249m       \u001b[49m\u001b[39m\r\r\n\u001b[48;5;235m\u001b[38;5;249mWinterJS.media.videoEncode({ data, width, height, count })\u001b[49m\u001b[39m\r\r\n\u001b[48;5;235m\u001b[38;5;249mWinterJS.media.mp4Info(bytes)\u001b[49m\u001b[39m\u001b[48;5;235m\u001b[38;5;249m                             \u001b[49m\u001b[39m\r\r\n\r\r\n\u001b[4mParameters\u001b[0m\r\r\n\r\r\n\u001b[38;5;240m•\u001b[39m \u001b[48;5;235m\u001b[38;5;249mbytes\u001b[49m\u001b[39m\r\r\n  \u001b[38;5;240m•\u001b[39m : A \u001b[48;5;235m\u001b[38;5;249mUint8Array\u001b[49m\u001b[39m holding the media file.\r\r\n"]

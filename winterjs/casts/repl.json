  },
  {
   "key": "\t",
   "after": 1.2
  },
  {
   "key": "\t",
   "after": 2.0
  },
  {
   "key": "\u0015",
   "after": 0.3
  },
  {
   "key": "\u001b",
   "after": 0.5
  },
  {
   "type": ".doc WinterJS.media.decodeAudio\r",
   "cps": 12
  },
  {
   "wait": 3.0
  },
  {
   "type": "await fetch(\"data:text/plain,hi\").then((r) => r.text())\r",
   "cps": 14
  },
  {
   "wait": 2.0
  }
 ],
 "setup": [
  "alias winterjs='winterjs -hide_banner'"
 ]
}
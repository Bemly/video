{
 "lines": [
  {
   "id": 1,
   "scene": "title",
   "zh": "必胜之道。",
   "math": "ke vo",
   "kana": "ケ・ヴォ。",
   "say": "Kelvora."
  },
  {
   "id": 2,
   "scene": "rule",
   "zh": "两个人，轮流行动。",
   "math": "su ne , ta ra",
   "kana": "スー・ネ、タ・ラ。",
   "say": "Siinea, tavaria."
  },
  {
   "id": 3,
   "scene": "rule",
   "zh": "无法行动的人，就输了。",
   "math": "ra ba ne , ze lu",
   "kana": "ラ・バ・ネ、ゼ・ルー。",
   "say": "Riabainea, ze lun."
  },
  {
   "id": 4,
   "scene": "kayles",
   "zh": "凯尔斯：击倒一根木柱，或者相邻的两根。",
   "math": "ko pi : ka en pi , o sa su pi",
   "kana": "コ・ピ。カ・エン・ピ、オ・サ・スー・ピ。",
   "say": "Koapil: kas einpil, o selsiipil."
  },
  {
   "id": 5,
   "scene": "wythoff",
   "zh": "威佐夫：王后走向角落，先到的人获胜。",
   "math": "ko go : go mo ki , sen mo ne ze ke",
   "kana": "コ・ゴ。ゴ・モ・キ、セン・モ・ネ、ゼ・ケ。",
   "say": "Koagora: goramon kiu, senmonea ze kel."
  },
  {
   "id": 6,
   "scene": "hackenbush",
   "zh": "砍竹：切断茎秆，离开地面的部分随之落下。",
   "math": "ko gi : tsu gi , ba da gi fa",
   "kana": "コ・ギ。ツ・ギ、バ・ダ・ギ・ファ。",
   "say": "Koagil: tsugil, baidalgil fai."
  },
  {
   "id": 7,
   "scene": "domineering",
   "zh": "多米诺：一人竖着放，一人横着放。",
   "math": "ko do : en ne do pi , en ne do da",
   "kana": "コ・ド。エン・ネ・ド・ピ、エン・ネ・ド・ダ。",
   "say": "Koadom: einnea dompil, einnea domdal."
  },
  {
   "id": 8,
   "scene": "chomp",
   "zh": "巧克力：咬下一块，吃到毒块的人输。",
   "math": "ko chi : chi , chi ha ne ze lu",
   "kana": "コ・チ。チ、チ・ハ・ネ、ゼ・ルー。",
   "say": "Koatsim: tsim, tsimhasnea ze lun."
  },
  {
   "id": 9,
   "scene": "infinite",
   "zh": "每个游戏十二关，之后关卡无穷无尽，随机生成。",
   "math": "so ko lo su re . po , re iri , ri ga",
   "kana": "ソ・コ、ロ・スー・レ。ポ、レ・イリ、リ・ガ。",
   "say": "Solkoa losiirem. Pos, rem iril, rigaun."
  },
  {
   "id": 10,
   "scene": "grundy",
   "zh": "每一个局面，都是一个数。",
   "math": "so ko , ze en ma",
   "kana": "ソ・コ、ゼ・エン・マ。",
   "say": "Solkoa, ze einmaa."
  },
  {
   "id": 11,
   "scene": "grundy",
   "zh": "数为零，先手必败。",
   "math": "ma ze nu , sen ne ze lu",
   "kana": "マ・ゼ・ヌ、セン・ネ・ゼ・ルー。",
   "say": "Maa ze nul, sennea ze lun."
  },
  {
   "id": 12,
   "scene": "machine",
   "zh": "机器思考这个数，找到让它归零的那一步。",
   "math": "ji vi de ma , fe ra : ma mo nu",
   "kana": "ジ・ヴィ・デ・マ、フェ・ラ、マ・モ・ヌ。",
   "say": "Jin vies demaa, feiria: maa mon nul."
  },
  {
   "id": 13,
   "scene": "montage",
   "zh": "无穷的关卡，同一个真理。",
   "math": "re iri , va en",
   "kana": "レ・イリ、ヴァ・エン。",
   "say": "Rem iril, vaal ein."
  },
  {
   "id": 14,
   "scene": "outro",
   "zh": "必胜之道——轮到你了。",
   "math": "ke vo . ta : mi",
   "kana": "ケ・ヴォ。タ、ミ。",
   "say": "Kelvora. Tava: mie."
  }
 ],
